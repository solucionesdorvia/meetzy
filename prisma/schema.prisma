generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String?
  image            String?
  emailVerified    DateTime?
  plan             String        @default("starter")
  stripeCustomerId String?
  isReseller       Boolean       @default(false)
  resellerBrand    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  isAdmin          Boolean       @default(false)
  accounts         Account[]
  sessions         Session[]
  sites            Site[]
  subscription     Subscription?
}

model Site {
  id                  String           @id @default(cuid())
  siteId              String           @unique @default(cuid())
  userId              String
  name                String
  url                 String
  plan                String           @default("starter")
  isActive            Boolean          @default(true)
  agentName           String           @default("Meetzy")
  agentRole           String           @default("Asistente virtual")
  agentPersonality    String           @default("amigable y profesional")
  welcomeMessage      String           @default("¡Hola! ¿En qué te puedo ayudar?")
  systemPrompt        String
  language            String           @default("es")
  avatarType          String?
  avatarSubtype       String?
  brandColor          String           @default("#6366f1")
  brandColor2         String           @default("#8b5cf6")
  logoUrl             String?
  avatarConfig        Json?
  voiceEnabled        Boolean          @default(false)
  voiceId             String?
  simliAvatarId       String?
  calBookingUrl       String?
  webhookUrl          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  embedMode           String           @default("widget")
  primaryQuestion     String?
  agentType           String           @default("guia")
  exitIntentEnabled   Boolean          @default(true)
  proactiveEnabled    Boolean          @default(true)
  proactiveFrequency  String           @default("normal")
  widgetPosition      String           @default("bottom-right")
  avatarImageUrl      String?
  avatarGenerations   Int              @default(0)
  onboardingCompleted Boolean          @default(false)
  onboardingStep      Int              @default(1)
  avatarStyle         String?
  avatarPrompt        String?
  avatarLastGenerated DateTime?
  conversations       Conversation[]
  knowledgeEntries    KnowledgeEntry[]
  user                User             @relation(fields: [userId], references: [id])
  visitorProfiles     VisitorProfile[]
}

model Conversation {
  id               String    @id @default(cuid())
  siteId           String
  visitorId        String
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  intentScore      Int       @default(0)
  visitorPersona   String?
  activeTime       Int       @default(0)
  browser          String?
  city             String?
  country          String?
  demoBooked       Boolean   @default(false)
  device           String?
  intentLabel      String    @default("exploring")
  intentSignalsLog Json?
  pagesVisited     String[]  @default([])
  referrer         String?
  scrollDepth      Int       @default(0)
  searchQuery      String?
  sectionsViewed   Json?
  sessionDuration  Int       @default(0)
  source           String?
  utmCampaign      String?
  utmMedium        String?
  utmSource        String?
  visitorCompany   String?
  visitorEmail     String?
  visitorName      String?
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@index([siteId])
  @@index([siteId, createdAt])
  @@index([siteId, visitorId])
  @@index([siteId, intentLabel])
}

model VisitorProfile {
  id             String        @id @default(cuid())
  visitorId      String
  siteId         String
  email          String?
  name           String?
  company        String?
  totalVisits    Int           @default(1)
  totalMessages  Int           @default(0)
  totalTime      Int           @default(0)
  maxIntentScore Int           @default(0)
  maxIntentLabel String        @default("exploring")
  demoBooked     Boolean       @default(false)
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  country        String?
  topSource      String?
  contactedAt    DateTime?
  notes          VisitorNote[]
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([visitorId, siteId])
  @@index([siteId])
  @@index([siteId, maxIntentLabel])
  @@index([siteId, lastSeenAt])
}

model VisitorNote {
  id        String         @id @default(cuid())
  profileId String
  content   String
  createdAt DateTime       @default(now())
  profile   VisitorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  uiComponents   Json?
  createdAt      DateTime     @default(now())
  intentScore    Float?
  intentSignals  Json?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeSubscriptionId String   @unique
  plan                 String
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  siteId    String
  title     String
  content   String
  type      String   @default("text")
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
